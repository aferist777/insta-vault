# Copy to .env and fill in only if you need authorized access (phase 4).
# Local UI port
VAULT_PORT=8765

# Optional: username whose instaloader session file lives in data/ig_session
IG_USERNAME=

# Optional: pull Instagram cookies straight from a browser profile for yt-dlp
# one of: chrome | firefox | edge | brave | opera | vivaldi
IG_COOKIES_FROM_BROWSER=
